// Tab Widget Example in Haiku
import GUI

// Initialize the GUI application
GUI.init()

// Create a window
let window = GUI.createWindow("Tab Widget Demo", 500, 400)

// Add a tab widget
GUI.addLabel(window, "Tab Widget Example:")
GUI.addTabWidget(window)

// Add tabs to the tab widget (widget index 1)
GUI.addTabToTabWidget(window, 1, "Home")
GUI.addTabToTabWidget(window, 1, "About")
GUI.addTabToTabWidget(window, 1, "Settings")
GUI.addTabToTabWidget(window, 1, "Help")

// Show the window
GUI.showWindow(window)

// Run the application
GUI.run()

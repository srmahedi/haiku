// Simple Text Editor with GUI in Haiku
import GUI

// Initialize the GUI application
GUI.init()

// Create a window
let window = GUI.createWindow("Haiku Text Editor", 600, 400)

// Add a text area for editing
GUI.addTextArea(window, "Start typing here...")

// Clear function
fn clearText() {
    GUI.setText(window, 0, "")
}

// Show text function
fn showText() {
    let text = GUI.getInput(window, 0)
    GUI.messageBox("Current Text", text, "info")
}

// Add buttons
GUI.addButton(window, "Clear", clearText)
GUI.addButton(window, "Show Text", showText)

// Show the window
GUI.showWindow(window)

// Run the application
GUI.run()
